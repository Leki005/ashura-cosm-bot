# .env.example — конфигурация бота AshuraCosm
# Скопируйте в .env и заполните своими значениями

# =============================================================================
# ОБЯЗАТЕЛЬНЫЕ
# =============================================================================

# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram ID администратора (Ашуры)
ADMIN_ID=123456789

# =============================================================================
# УВЕДОМЛЕНИЯ
# =============================================================================

# Кому слать уведомления о записях (если не задан, = ADMIN_ID)
OWNER_ID=123456789

# Кому слать уведомления об ошибках и сбоях
ERROR_NOTIFY_ID=123456789

# =============================================================================
# ИИ-КОНСУЛЬТАНТ (Grok / xAI)
# =============================================================================

XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT=60
XAI_VISION_MODEL=grok-4.5
AI_HISTORY_LIMIT=20
AI_DAILY_LIMIT=500

# =============================================================================
# KIMI K3 API
# =============================================================================

KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
KIMI_PROXY=socks5://127.0.0.1:10808
KIMI_TIMEOUT=300

# =============================================================================
# ПРОКСИ (Happ / Reality / V2Ray)
# =============================================================================

# Автоопределение рабочего прокси
PROXY_AUTO=true
PROXY_HOST=127.0.0.1
PROXY_PORTS=10808,10809,1080,7890,7891
PROXY_SCHEMES=socks5,http

# Проверка SSL (true = безопасно, false = для Reality-прокси Happ)
PROXY_SSL_VERIFY=true

# Таймаут пробы прокси (секунды)
PROXY_PROBE_TIMEOUT=12

# Таймаут Telegram API (секунды)
TELEGRAM_TIMEOUT=60

# =============================================================================
# БАЗА ДАННЫХ
# =============================================================================

# SQLite (по умолчанию) или PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Redis (для FSM и кэширования; если не задан — MemoryStorage)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# МОНИТОРИНГ (ОПЦИОНАЛЬНО)
# =============================================================================

# Sentry DSN для отслеживания ошибок
# SENTRY_DSN=https://your_key@sentry.io/your_project

# Формат логов: text (по умолчанию) или json
# LOG_FORMAT=text

# Сброс pending updates при старте (true только при аварийном запуске)
DROP_PENDING_UPDATES=false

# Требовать Redis (fail-hard если недоступен)
REQUIRE_REDIS=false

# Пароль Redis (для подключения бота и Redis-контейнера)
REDIS_PASSWORD=your_redis_password_here

# Лимит AI-запросов на пользователя в день
AI_DAILY_LIMIT_PER_USER=50

# Максимум одновременных AI-запросов
AI_MAX_CONCURRENT=5
